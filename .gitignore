# KaliSOS — repository-wide ignores.
# The client/ and server/ workspaces each keep their own .gitignore as well;
# the rules here apply to every directory, including any new workspace.

# Secrets ------------------------------------------------------------------
# .env holds the Supabase service role key, which bypasses Row Level Security.
# It must never reach the repository.
.env
.env.*

# The template carries placeholder values only and is required by other
# developers, so it is deliberately exempted. This negation must stay after the
# .env.* rule above — git applies the last matching pattern.
!.env.example

# Dependencies -------------------------------------------------------------
node_modules

# Build output -------------------------------------------------------------
dist
dist-ssr
build

# Test output --------------------------------------------------------------
coverage
*.lcov

# Logs ---------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
